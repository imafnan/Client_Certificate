# Copy to .env and fill in values. Never commit .env.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority

PORT=3000

# Cloudinary — required for hero/gallery image uploads (admin endpoints)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First-time admin: POST /admin/bootstrap with JSON { "email", "password" } when no admin exists yet.
# Admin email/password are stored only in MongoDB — not in this file.
