# Copy to .env and fill in values. Never commit .env.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster1.1mavhjh.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority

# If you still see querySrv ECONNREFUSED on Windows, try uncommenting custom DNS:
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Or use Atlas "standard connection string" (mongodb://...) instead of mongodb+srv://

# Set to 1 only if you must use the OS resolver only (e.g. corporate DNS policy).
# MONGODB_SKIP_DNS_OVERRIDE=1

PORT=3000

# Seeded into MongoDB on startup (password stored as bcrypt hash only).
Adminemail=your-admin@example.com
Adminpassword=your-secure-password

# Alternative names:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
